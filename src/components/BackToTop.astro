<a href="#top" class="back-to-top" aria-label="Back to top" id="backToTop">
  &uarr;
</a>

<style>
  .back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--royal);
    color: var(--on-royal);
    border-radius: 50%;
    text-decoration: none;
    font-size: 1.1rem;
    box-shadow: 0 8px 20px -8px rgba(11, 37, 69, 0.5);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s ease;
    z-index: 60;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .back-to-top:hover {
    background: var(--royal-dark);
    text-decoration: none;
  }
</style>

<script>
  const button = document.getElementById('backToTop');

  if (button) {
    const toggle = () => {
      button.classList.toggle('visible', window.scrollY > 560);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
  }
</script>
