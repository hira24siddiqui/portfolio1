---
import CaseStudyCard from './CaseStudyCard.astro';

interface CaseStudy {
  title: string;
  summary: string;
  tags: string[];
  slug: string;
}

interface Props {
  title: string;
  cases: CaseStudy[];
}

const { title, cases } = Astro.props;
---

<div class="category">
  <h3>{title}</h3>
  {cases.length > 0 ? (
    <div class="cards">
      {cases.map((c) => (
        <CaseStudyCard title={c.title} summary={c.summary} tags={c.tags} href={`/case-studies/${c.slug}/`} />
      ))}
    </div>
  ) : (
    <p class="empty">Case studies coming soon.</p>
  )}
</div>

<style>
  .category {
    margin-bottom: 32px;
  }

  .category h3 {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .empty {
    color: var(--text-faint);
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
