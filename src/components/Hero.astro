---
interface Props {
  name: string;
  tagline: string;
}

const { name, tagline } = Astro.props;
---

<section id="top" class="hero">
  <div class="container">
    <span class="eyebrow">My Portfolio</span>
    <h1>{name}</h1>
    <span class="accent-bar"></span>
    <p class="tagline">{tagline}</p>
  </div>
</section>

<style>
  .hero {
    padding-top: 96px;
    padding-bottom: 48px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -120px;
    right: -120px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--royal-soft) 0%, transparent 70%);
    pointer-events: none;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 0.5em;
  }

  .accent-bar {
    display: block;
    width: 64px;
    height: 4px;
    background: var(--royal);
    border-radius: 2px;
    margin-bottom: 1.2em;
  }

  .tagline {
    color: var(--text-dim);
    font-size: 1.1rem;
    max-width: 640px;
    position: relative;
  }
</style>
