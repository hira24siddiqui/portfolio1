---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  paragraphs: string[];
}

const { id, eyebrow, title, paragraphs } = Astro.props;
---

<section id={id}>
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    <div class="body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .body {
    max-width: 720px;
    color: var(--text-dim);
  }

  .body p {
    margin: 0 0 1em;
  }
</style>
